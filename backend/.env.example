APP_NAME="AI Fabric Reconstruction"
APP_ENV="development"
SECRET_KEY="replace-with-a-secure-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fabric_reconstruction"
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"
DATASET_DIR="../dataset/cleaned"
ALLOWED_EXTENSIONS=".jpg,.jpeg,.png"
MAX_FILE_SIZE_MB=10
npm run